   }
 
-  $string = `$make_path -j 2 -f null.mk $redir`;
+  $string = `"$make_path" -j 2 -f null.mk $redir`;
   if ($string =~ /not supported/) {
     $parallel_jobs = 0;
   }
@@ -670,7 +670,7 @@ sub set_more_defaults
