+  %FEATURES = map { $_ => 1 } split /\s+/, `"$make_path" -sf features.mk`;
   print "$make_path FEATURES: @{[%FEATURES]}\n" if $verbose;
   unlink('features.mk');
 
@@ -680,7 +680,7 @@  sub set_more_defaults
       $s .= "\$(info $_=\$($_))\n";
   }
   create_file('defvars.mk', $s);
-  foreach (split "\n", `$make_path -sf defvars.mk`) {
+  foreach (split "\n", `"$make_path" -sf defvars.mk`) {
