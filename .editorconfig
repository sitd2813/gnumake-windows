# EditorConfig is awesome: https://editorconfig.org

# top-most EditorConfig file
root = true

[*]
indent_style = tab
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# Makefile
[{makefile,*.mk}]
end_of_line = lf

# Markdown
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

# Patch files
[*.patch]
indent_style = unset
end_of_line = lf
trim_trailing_whitespace = false
[patches/make-4.4.1-{build_w32_arm64-1,build_w32_detect_build_tools,build_w32_preserve_exit_status,build_w32_spectre-1}.patch]
end_of_line = crlf

# YAML
[*.yml]
indent_style = space
indent_size = 2
